# =============================================================================
# Credenciales sensibles — copia este archivo a .env y completa los valores.
# No subas .env al repositorio.
#
# Ciudad, delays, límites de scrape, WhatsApp, Lovable (timeout/headless), mapa
# y plantillas se configuran en Administración (persistido en BD) y exigen rol admin.
# =============================================================================

# development | test | production
# production exige AUTH_MODE=oidc y ALLOWED_ORIGINS explícito (nunca *).
APP_ENV=development

# Orígenes del frontend. Vacío en development usa localhost:5173 y :8000.
# No uses *.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# local (solo development/test) | oidc
AUTH_MODE=local
# Secreto HMAC para emitir JWT locales. No es una contraseña de usuario.
# Genera un valor largo y aleatorio. En production este modo está prohibido.
AUTH_LOCAL_SECRET=
# Emitir un token admin local, sin imprimir el secreto:
#   python -m backend.core.auth admin
# El único archivo de entorno es .env en la raíz. No crees frontend/.env ni .env.local.

# Supabase Auth. Vacío aquí. Los valores reales van solo en el .env de la raíz.
# Vite inyecta URL y clave publicable. SUPABASE_SECRET_KEY no llega al navegador.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# OIDC, obligatorio si APP_ENV=production
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Consola SQL: apagada por defecto. Aunque se encienda, solo acepta SELECT.
ALLOW_SQL_CONSOLE=0
# En production hace falta, además, exactamente este valor. Sigue siendo solo lectura y con rol admin.
# SQL_CONSOLE_PRODUCTION_ACK=read-only-acknowledged

# Outreach real solo es posible con APP_ENV=production y este flag en true.
# development y test ignoran el flag y quedan en dry-run.
OUTREACH_ENABLED=false

# OpenAI — usado por automatizaciones que acceden a ChatGPT vía navegador
OPENAI_EMAIL=tu_email@ejemplo.com
OPENAI_PASSWORD=

# LOVABLE_ACCOUNTS está declarado pero AccountManager no lo lee.
# La rotación actual usa perfiles locales account_1..account_6, no esta variable.
# No guardes contraseñas de Lovable. La conexión nueva es OAuth/MCP.
# LOVABLE_BROWSER_AUTOMATION_ENABLED queda apagado; no lo enciendas para evadir un login.
LOVABLE_ACCOUNTS=[]
LOVABLE_BROWSER_AUTOMATION_ENABLED=0

# El scraper DOM de Google Maps queda apagado. El pipeline de desarrollo usa el proveedor simulado.
# Places API (New) solo se llama si hay clave y el proveedor lo pide. No pongas una clave en el repo.
LEGACY_MAPS_SCRAPER_ENABLED=0
DISCOVERY_PROVIDER=simulated
GOOGLE_PLACES_API_KEY=

# Clave maestra para cifrar tokens de proveedor. No se guarda en la base.
# Sin esta clave el sistema rechaza guardar un token.
PLATFORM_SECRET_KEY=

# Postgres (Supabase, pooler en modo sesión, puerto 5432). Obligatorio: no hay respaldo SQLite.
# Todo vive en el schema crm, que no está expuesto en la Data API.
# backend/scripts/db_bootstrap.py crea los roles y escribe estas URLs; no las copies a mano.
#   DATABASE_URL           rol crm_app: la API y el worker
#   DATABASE_READONLY_URL  rol crm_readonly: consola SQL (solo lectura, 5 s)
#   DATABASE_INGEST_URL    rol crm_ingest: scripts locales (rescrape_all.py, data/scripts/*,
#                          backend/scripts/run_*). Solo prospects y category_catalog, sin DELETE.
#                          Los scripts nunca usan DATABASE_URL.
#   DATABASE_ADMIN_URL     rol postgres: solo bootstrap y pruebas; nunca en el VM
# Las pruebas usan TEST_DATABASE_URL o, si falta, DATABASE_ADMIN_URL, en un schema crm_test_* desechable.
DATABASE_URL=
DATABASE_READONLY_URL=
DATABASE_INGEST_URL=
DATABASE_ADMIN_URL=
# DATABASE_SCHEMA=crm

# Archivos de negocio (PDF de cotizaciones, fotos). Con FILES_BUCKET van al bucket
# privado de GCS (credenciales ADC: gcloud auth application-default login); sin él,
# a data/files/. En APP_ENV=production es obligatorio (el VM no guarda archivos).
# FILES_BUCKET=ashencrm-files

