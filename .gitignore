# Entornos y logs
.env
.env.*
!.env.example
.vercel/
.venv/

# Terraform
infra/gcp/.terraform/
infra/gcp/.terraform.lock.hcl
infra/gcp/terraform.tfstate
infra/gcp/terraform.tfstate.*
infra/gcp/terraform.tfvars
infra/gcp/*.auto.tfvars
infra/gcp/crash.log
# Un plan guardado lleva los valores de terraform.tfvars en texto plano.
infra/gcp/*.tfplan
__pycache__/
*.pyc
*.egg-info/
logs/
.pytest_cache/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Datos SQLite, sesiones de navegador y capturas.
# Los .db que ya están en el índice siguen trackeados hasta que una persona
# ejecute git rm --cached después de un backup. Ver docs/modernization/data-sanitization.md
data/db/*.db
data/db/*.db-*
data/db/*.sqlite
data/db/*.sqlite3
data/screenshots/
# Archivos de negocio en desarrollo (en producción van al bucket ashencrm-files).
data/files/
data/client_uploads/
data/browser_data/
data/exports/
data/exports/*.db
data/sessions/
**/storage_state.json
**/*storage_state*.json
playwright/.auth/
unused/

# Vite/React
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.DS_Store
.vercel
.env*
