#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/ashencrm-startup.log) 2>&1
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y python3 python3-venv python3-pip git curl

install -d -o root -g root /opt/ashencrm
if [ ! -d /opt/ashencrm/repo/.git ]; then
  git clone --depth 1 --branch "${git_branch}" "${git_repo}" /opt/ashencrm/repo
else
  cd /opt/ashencrm/repo
  # reset --hard: un archivo local modificado nunca bloquea el arranque.
  # El VM no guarda datos de negocio (todo vive en Supabase), así que no hay nada que proteger.
  git fetch --depth 1 origin "${git_branch}"
  git reset --hard "origin/${git_branch}"
fi

cd /opt/ashencrm/repo
python3 -m venv /opt/ashencrm/venv
/opt/ashencrm/venv/bin/pip install --upgrade pip setuptools wheel
/opt/ashencrm/venv/bin/pip install -e . "uvicorn[standard]"

ACCESS_TOKEN=$(curl -s -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | python3 -c 'import sys,json; print(json.load(sys.stdin)["access_token"])')

# -f: un secreto sin versión o sin permiso hace fallar el arranque (set -e) en vez de
# escribir un valor vacío en .env. Por eso se leen a variables antes del heredoc.
fetch_secret() {
  local name="$1"
  curl -sf -H "Authorization: Bearer $${ACCESS_TOKEN}" \
    "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$${name}/versions/latest:access" \
    | python3 -c 'import sys,json,base64; print(base64.b64decode(json.load(sys.stdin)["payload"]["data"]).decode())'
}

SUPABASE_URL=$(fetch_secret ashencrm-supabase-url)
SUPABASE_PUBLISHABLE_KEY=$(fetch_secret ashencrm-supabase-publishable-key)
SUPABASE_SECRET_KEY=$(fetch_secret ashencrm-supabase-secret-key)
SUPABASE_JWKS_URL=$(fetch_secret ashencrm-supabase-jwks-url)
PLATFORM_SECRET_KEY=$(fetch_secret ashencrm-platform-secret-key)
# Obligatoria: sin ella la API no arranca (no hay respaldo SQLite).
DATABASE_URL=$(fetch_secret ashencrm-database-url)
# Opcional: sin ella la consola SQL usa crm_app en transacción READ ONLY.
DATABASE_READONLY_URL=$(fetch_secret ashencrm-database-readonly-url || true)

cat >/opt/ashencrm/repo/.env <<EOF
APP_ENV=production
AUTH_MODE=oidc
ALLOWED_ORIGINS=${allowed_origins}
SUPABASE_URL=$${SUPABASE_URL}
SUPABASE_PUBLISHABLE_KEY=$${SUPABASE_PUBLISHABLE_KEY}
SUPABASE_SECRET_KEY=$${SUPABASE_SECRET_KEY}
SUPABASE_JWKS_URL=$${SUPABASE_JWKS_URL}
OIDC_ISSUER=$${SUPABASE_URL}/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URL=$${SUPABASE_JWKS_URL}
PLATFORM_SECRET_KEY=$${PLATFORM_SECRET_KEY}
DATABASE_URL=$${DATABASE_URL}
DATABASE_READONLY_URL=$${DATABASE_READONLY_URL}
DATABASE_SCHEMA=crm
OUTREACH_ENABLED=false
DISCOVERY_PROVIDER=simulated
LEGACY_MAPS_SCRAPER_ENABLED=0
LOVABLE_BROWSER_AUTOMATION_ENABLED=0
EOF
chmod 600 /opt/ashencrm/repo/.env

cat >/etc/systemd/system/ashencrm.service <<'UNIT'
[Unit]
Description=AshenCRM FastAPI + worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ashencrm/repo
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ashencrm/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable ashencrm
systemctl restart ashencrm
systemctl --no-pager --full status ashencrm || true
